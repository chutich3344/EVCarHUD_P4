void showPacket(const uint8_t *data, size_t size) {
  if (size == 29 && data[12] == 0x01 && data[13] == 0x01) {
    static int lastCandidate = -1;
    const int candidate = data[20];

    if (candidate != lastCandidate) {
      Serial.printf("VML LIMIT CANDIDATE: %d\n", candidate);
      lastCandidate = candidate;
      char line[40];
      snprintf(line, sizeof line, "LIMIT CANDIDATE %d", candidate);
      logStore(line, data, size);
      lcd.fillRect(0, 231, lcd.width(), 9, black);
      lcd.setTextSize(1);
      lcd.setTextColor(white);
      lcd.setCursor(12, 231);
      lcd.print("Bien hien tai (ung vien): ");
      lcd.print(candidate);
    }
    return;
  }

  Guidance g;
  if (!parseGuidance(data, size, g)) {
    logHex("VML LA", data, size);
    char line[48];
    snprintf(line, sizeof line, "LA len=%u cmd=%02X%02X", (unsigned)size,
             size > 13 ? data[12] : 0, size > 13 ? data[13] : 0);
    logStore(line, data, size > 4096 ? 4096 : size);
    return;
  }

  if (g.nextLimit) {
    logGuidance("VML BIEN", g.meters, g.jpegLength, g.label, g.labelLength);
    logGuidanceStore("BIEN", data, size, g.meters, g.jpeg, g.jpegLength, g.label, g.labelLength);
    signAt = millis();
    if (warnVisible) return;   // dang hien canh bao o duoi: de canh bao, bien ve lai sau
    if (!signVisible) lcd.fillRect(0, 152, lcd.width(), 78, panel);
    if (g.jpeg) {
      uint16_t w = 0, h = 0;
      if (TJpgDec.getJpgSize(&w, &h, g.jpeg, g.jpegLength) == JDR_OK &&
          w == 60 && h == 60 &&
          TJpgDec.drawJpg(0, 0, g.jpeg, g.jpegLength) == JDR_OK) {
        lcd.drawRGBBitmap(lcd.width() - 72, 161, icon, 60, 60);
      }
    }
    if (!signVisible || signMeters != g.meters) {
      lcd.fillRect(0, 152, lcd.width() - 76, 78, panel);
      lcd.setTextColor(muted);
      lcd.setTextSize(2);
      lcd.setCursor(12, 162);
      lcd.print("Bien tiep");
      lcd.setTextColor(white);
      lcd.setCursor(12, 188);
      printDistance(g.meters, 3, 2);
      signVisible = true;
      signMeters = g.meters;
    }
    return;
  }

  if (g.jpeg) {
    uint16_t w = 0, h = 0;
    if (TJpgDec.getJpgSize(&w, &h, g.jpeg, g.jpegLength) != JDR_OK ||
        w != 60 || h != 60 ||
        TJpgDec.drawJpg(0, 0, g.jpeg, g.jpegLength) != JDR_OK) {
      logGuidance("VML ANH LOI", g.meters, g.jpegLength, g.label, g.labelLength);
      return;
    }

    // Confirm the blue cue seen in the recorded arrow. Ignore other icons.
    unsigned blue = 0, red = 0;
    for (uint16_t color : icon) {
      const int r = ((color >> 11) & 31) * 2;
      const int green = (color >> 5) & 63;
      const int b = (color & 31) * 2;
      if (b > 30 && b > r + 15 && b > green + 4) ++blue;
      if (r > 30 && r > b + 15 && r > green + 15) ++red;
    }
    if (blue < 60 || red >= 30) {
      Serial.printf("VML ICON KHAC (xanh=%u do=%u) ", blue, red);
      logGuidance("", g.meters, g.jpegLength, g.label, g.labelLength);
      logGuidanceStore("CANHBAO", data, size, g.meters, g.jpeg, g.jpegLength, g.label, g.labelLength);
      showWarning(true, g.meters, g.label, g.labelLength);
      return;
    }
    logGuidanceStore("RE", data, size, g.meters, g.jpeg, g.jpegLength, g.label, g.labelLength);
    lcd.fillRect(0, 42, lcd.width(), 102, panel);
    lcd.drawRGBBitmap(12, 48, icon, 60, 60);
    turnLabel = "";
    turnLabel.reserve(g.labelLength);
    for (size_t i = 0; i < g.labelLength; ++i) turnLabel += g.label[i];
    turnVisible = true;
    drawTurnDistance(g.meters);
    drawStreet(g.label, g.labelLength);
  } else {
    // Text-only updates must match the road of the last accepted arrow.
    if (!turnVisible || turnLabel.length() != g.labelLength ||
        memcmp(turnLabel.c_str(), g.label, g.labelLength) != 0) {
      logGuidance("VML CHU KHAC", g.meters, g.jpegLength, g.label, g.labelLength);
      logGuidanceStore("CHU", data, size, g.meters, nullptr, 0, g.label, g.labelLength);
      // Canh bao chi co chu (khong anh) cung hien o duoi
      if (!turnVisible || warnVisible) showWarning(false, g.meters, g.label, g.labelLength);
      return;
    }
    if (turnMeters != g.meters) drawTurnDistance(g.meters);
  }

  turnAt = millis();
  Serial.printf("VML TURN: %lu m | %.*s\n", (unsigned long)g.meters,
                (int)g.labelLength, g.label);
}

void inspectByte(uint8_t value) {
  if (used < sizeof(magic) && value != magic[used]) {
    used = (value == magic[0]) ? 1 : 0;
    if (used) packet[0] = value;
    return;
  }
  packet[used++] = value;
  if (used == 8) {
    uint32_t length = readBE32(packet + 4);
    if (length < 6 || length > sizeof(packet) - 8) {
      used = expected = 0;
      return;
    }
    expected = length + 8;
  }
  if (!expected || used != expected) return;
  if (used == 22 && packet[12] == 0x0E && packet[13] == 0x00) {
    bt.write(reinterpret_cast<const uint8_t *>(h1vInfo), sizeof(h1vInfo) - 1);
    Serial.println("VML: app hoi thong tin, da tra loi H1V");
  } else {
    showPacket(packet, used);
  }
  used = expected = 0;
}

void setup() {
  Serial.begin(115200);
  lcdSpi.begin(14, 12, 13, 15);
#if HUD_ST7789
  lcd.init(240, 320);
  lcd.setSPISpeed(10000000);
#else
  lcd.begin(10000000);
#endif
  lcd.setRotation(hudRotation);
#if HUD_ST7789
  lcd.invertDisplay(false);
#endif
  lcd.fillScreen(black);
  pinMode(21, OUTPUT);
  digitalWrite(21, HIGH);
  lcd.drawFastHLine(0, 35, lcd.width(), accent);
  lcd.setTextColor(accent);
  lcd.setTextSize(2);
  lcd.setCursor(12, 12);
  lcd.print("VIETMAP LIVE V5.3");
  drawStatus(false);
  pinMode(0, INPUT_PULLUP);
  fsOk = LittleFS.begin(true);   // lan dau tu dinh dang vung luu
  if (fsOk) {
    File f = LittleFS.open(logPath, FILE_READ);
    if (f) { logSize = f.size(); f.close(); }
    logStore("--- HUD khoi dong V5.3 ---", nullptr, 0);
  }
  Serial.printf("Log flash: %s, %u byte\n", fsOk ? "OK" : "LOI", (unsigned)logSize);
  drawLogSize();
  clearTurn();

  TJpgDec.setCallback(copyIcon);
  TJpgDec.setSwapBytes(false);
  phoneRx = xStreamBufferCreate(32768, 1);
  if (!phoneRx) {
    Serial.println("SPP buffer allocation failed");
    return;
  }
  bt.onData([](const uint8_t *data, size_t length) {
    while (length) {
      size_t count = xStreamBufferSend(phoneRx, data, length, pdMS_TO_TICKS(50));
      if (!count) return;
      data += count;
      length -= count;
    }
  });
  Serial.println(bt.begin("VIETMAP_HUD_TEST") ?
                 "SPP ready: VIETMAP_HUD_TEST" : "SPP start failed");
}

void loop() {
  if (!phoneRx) {
    delay(100);
    return;
  }
  uint8_t data[512];
  size_t count = xStreamBufferReceive(phoneRx, data, sizeof(data), pdMS_TO_TICKS(10));
  const uint32_t now = millis();
  if (now - lastByteAt > 1000) used = expected = 0;
  if (count) lastByteAt = now;
  for (size_t i = 0; i < count; ++i) inspectByte(data[i]);

  if (bt.hasClient() != lastConnected) {
    drawStatus(!lastConnected);
    logStore(lastConnected ? "dien thoai noi" : "dien thoai rot", nullptr, 0);
  }
  // Nut BOOT: bam = xuat log ra USB; giu 5 giay = xoa log
  static uint32_t bootDownAt;
  if (digitalRead(0) == LOW) {
    if (!bootDownAt) bootDownAt = millis() | 1;
    if (millis() - bootDownAt > 5000 && fsOk) {
      LittleFS.remove(logPath);
      logSize = 0;
      seenCount = 0;
      Serial.println("VML: da xoa log");
      drawLogSize();
      while (digitalRead(0) == LOW) delay(10);
      bootDownAt = 0;
    }
  } else if (bootDownAt) {
    if (millis() - bootDownAt > 50 && fsOk) dumpLog();
    bootDownAt = 0;
  }
  if (warnVisible && millis() - warnAt > warnTimeoutMs) {
    lcd.fillRect(0, 152, lcd.width(), 78, black);
    warnVisible = false;
  }
  if (turnVisible && (!bt.hasClient() || millis() - turnAt > 5000)) clearTurn();
  if (signVisible && (!bt.hasClient() || millis() - signAt > signTimeoutMs)) {
    lcd.fillRect(0, 152, lcd.width(), 78, black);
    signVisible = false;
  }
}

