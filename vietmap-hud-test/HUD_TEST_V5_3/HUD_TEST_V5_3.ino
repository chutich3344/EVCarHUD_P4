  lcd.fillRect(220, 10, 68, 18, black);
  lcd.setTextSize(1);
  lcd.setTextColor(logSize >= logMax ? dotOff : muted);
  lcd.setCursor(222, 15);
  if (!fsOk) lcd.print("log loi");
  else if (logSize >= logMax) lcd.print("LOG DAY");
  else {
    lcd.print("log ");
    lcd.print((unsigned long)(logSize / 1024));
    lcd.print("K");
  }
}

// Ghi 1 dong chu + (tuy chon) ca goi dang hex vao flash. Mo/dong moi lan: tat may xe khong mat log.
void logStore(const char *line, const uint8_t *data, size_t size) {
  if (!fsOk || logSize >= logMax) return;
  File f = LittleFS.open(logPath, FILE_APPEND);
  if (!f) return;
  size_t before = f.size();
  f.printf("#%lu %s\n", (unsigned long)(millis() / 1000), line);
  if (data) {
    static const char hx[] = "0123456789ABCDEF";
    char buf[129];
    for (size_t i = 0; i < size; i += 64) {
      size_t k = 0;
      for (size_t j = i; j < size && j < i + 64; ++j) {
        buf[k++] = hx[data[j] >> 4];
        buf[k++] = hx[data[j] & 15];
      }
      buf[k] = 0;
      f.println(buf);
    }
  }
  logSize = f.size();
  f.close();
  if (logSize / 4096 != before / 4096) drawLogSize();
}

void logGuidanceStore(const char *tag, const uint8_t *data, size_t size, uint32_t meters,
                      const uint8_t *jpeg, size_t jpegLength, const char *label, size_t labelLength) {
  char line[200];
  const uint32_t s = jpeg ? sumOf(jpeg, jpegLength) : 0;
  snprintf(line, sizeof line, "%s m=%lu anh=%08lX %.*s", tag, (unsigned long)meters,
           (unsigned long)s, (int)(labelLength > 120 ? 120 : labelLength), label);
  // Anh moi gap lan dau: luu ca goi (de giai anh -> so bien / loai camera); lan sau chi luu 1 dong
  const bool full = jpeg && firstSeen(s);
  logStore(line, full ? data : nullptr, size);
}

