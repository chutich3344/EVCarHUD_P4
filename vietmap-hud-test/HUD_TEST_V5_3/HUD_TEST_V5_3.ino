// Parser uses the same bounds on the ESP32 and in the desktop replay.
struct Guidance {
  const uint8_t *jpeg;
  size_t jpegLength;
  uint32_t meters;
  const char *label;
  size_t labelLength;
  bool nextLimit;
};

uint32_t readBE32(const uint8_t *p) {
  return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) |
         (uint32_t(p[2]) << 8) | uint32_t(p[3]);
}

bool parseGuidance(const uint8_t *p, size_t size, Guidance &out);

bool parseGuidance(const uint8_t *p, size_t size, Guidance &out) {
  if (size < 32 || p[12] != 0x40 || p[13] != 0xFE) return false;
  const size_t end = size - 8;
  const uint32_t length = readBE32(p + 14);
  size_t meta = 19;
  out = {};
  if (length != 1) {
    if (length < 4 || length > end - 18) return false;
    meta = 18 + length;
    if (p[18] != 0xFF || p[19] != 0xD8 ||
        p[meta - 2] != 0xFF || p[meta - 1] != 0xD9) return false;
    out.jpeg = p + 18;
    out.jpegLength = length;
  } else if (p[18] != 1) {
    return false;
  }
  if (end - meta < 5) return false;
  out.meters = readBE32(p + meta);
  out.labelLength = p[meta + 4];
  if (out.meters == UINT32_MAX || !out.labelLength ||
      out.labelLength > end - meta - 5) return false;
  out.label = reinterpret_cast<const char *>(p + meta + 5);
  constexpr char warning[] = "Tốc độ tiếp theo";
  out.nextLimit = out.labelLength == sizeof(warning) - 1 &&
      std::memcmp(out.label, warning, sizeof(warning) - 1) == 0;
  return true;
}
// End portable parser.

bool copyIcon(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t *pixels) {
  if (x < 0 || y < 0 || x + w > 60 || y + h > 60) return false;
  for (uint16_t row = 0; row < h; ++row) {
    memcpy(icon + (y + row) * 60 + x, pixels + row * w, w * sizeof(uint16_t));
  }
  return true;
}

