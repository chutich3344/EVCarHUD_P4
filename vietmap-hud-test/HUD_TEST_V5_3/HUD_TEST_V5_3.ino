int streetGlyph(uint16_t code) {
  if (code >= 32 && code <= 126) return code - 32;
  if (code >= 0xC0 && code <= 0xFF) return 95 + code - 0xC0;
  static const uint16_t extra[] = {
    0x102, 0x103, 0x110, 0x111, 0x128, 0x129,
    0x168, 0x169, 0x1A0, 0x1A1, 0x1AF, 0x1B0
  };
  for (int i = 0; i < 12; ++i) {
    if (extra[i] == code) return 159 + i;
  }
  if (code >= 0x1EA0 && code <= 0x1EF9) return 171 + code - 0x1EA0;
  return '?' - 32;
}

void drawStreet(const char *text, size_t size) {
  int x = 12;
  for (size_t i = 0; i < size && x + 10 <= lcd.width() - 8;) {
    const uint8_t first = text[i++];
    uint16_t code = first;
    if (first >= 0xC2 && first <= 0xDF && i < size &&
        (uint8_t(text[i]) & 0xC0) == 0x80) {
      code = ((first & 0x1F) << 6) | (uint8_t(text[i++]) & 0x3F);
    } else if (first >= 0xE0 && first <= 0xEF && i + 1 < size &&
               (uint8_t(text[i]) & 0xC0) == 0x80 &&
               (uint8_t(text[i + 1]) & 0xC0) == 0x80) {
      code = ((first & 0x0F) << 12) | ((uint8_t(text[i]) & 0x3F) << 6) |
             (uint8_t(text[i + 1]) & 0x3F);
      i += 2;
    } else if (first >= 0x80) {
      code = '?';
      while (i < size && (uint8_t(text[i]) & 0xC0) == 0x80) ++i;
    }
    lcd.drawBitmap(x, 117, streetFont + 44 * streetGlyph(code), 10, 22, white);
    x += 10;
  }
}

// V5.1: >= 1000 m hien "1,2 km"
void printDistance(uint32_t meters, uint8_t bigSize, uint8_t unitSize) {
  lcd.setTextSize(bigSize);
  if (meters < 1000) {
    lcd.print(meters);
    lcd.setTextSize(unitSize);
    lcd.print(" m");
    return;
  }
  const uint32_t tenth = (meters + 50) / 100;
  lcd.print(tenth / 10);
  if (tenth < 100) {
    lcd.print(',');
    lcd.print(tenth % 10);
  }
  lcd.setTextSize(unitSize);
  lcd.print(" km");
}

// V5.1: log hex goi chua giai duoc de giai tiep camera / toc do hien tai
void logHex(const char *tag, const uint8_t *data, size_t size) {
  Serial.printf("%s len=%u cmd=%02X%02X:", tag, (unsigned)size,
                size > 13 ? data[12] : 0, size > 13 ? data[13] : 0);
  const size_t n = size > 512 ? 512 : size;
  for (size_t i = 0; i < n; ++i) {
    if (i % 32 == 0) Serial.print("\n  ");
    Serial.printf("%02X ", data[i]);
  }
  if (n < size) Serial.print("...");
  Serial.println();
}

void logGuidance(const char *tag, uint32_t meters, size_t jpegLength,
                 const char *label, size_t labelLength) {
  Serial.printf("%s: %lu m | anh=%u byte | %.*s\n", tag,
                (unsigned long)meters, (unsigned)jpegLength,
                (int)labelLength, label);
}

uint32_t sumOf(const uint8_t *p, size_t n) {   // FNV-1a: nhan dang anh trung nhau
  uint32_t h = 2166136261u;
  for (size_t i = 0; i < n; ++i) h = (h ^ p[i]) * 16777619u;
  return h;
}

bool firstSeen(uint32_t s) {
  for (size_t i = 0; i < seenCount; ++i) if (seenSum[i] == s) return false;
  if (seenCount < sizeof(seenSum) / sizeof(seenSum[0])) seenSum[seenCount++] = s;
  return true;
}

